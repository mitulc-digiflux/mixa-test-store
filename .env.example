# Public URL of this test store. Used as shopUrl in the webhook and to rewrite
# destinationUrl in the exported catalogue CSV (creator links land here).
SITE_URL=http://localhost:3000

# From mixa onboarding (Section 3). Server only, never NEXT_PUBLIC.
MIXA_BRAND_ID=
MIXA_WEBHOOK_SECRET=
MIXA_WEBHOOK_URL=https://api.mixa.global/v1/orders/webhook

# Tracking (Section 2). Use ONE: "gtm" (script lives in a GTM Custom HTML tag)
# or "direct" (this app injects the script itself). "none" = coupon-only test.
NEXT_PUBLIC_TRACKING_MODE=gtm
NEXT_PUBLIC_GTM_ID=
# Only used when NEXT_PUBLIC_TRACKING_MODE=direct
NEXT_PUBLIC_MIXA_BRAND_ID=
